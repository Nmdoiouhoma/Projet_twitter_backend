# .env
# ... autres variables ...

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=votre_secret_symfony_long_et_aleatoire_ici
# APP_SHARE_DIR=var/share # Décommentez si nécessaire

###> lexik/jwt-authentication-bundle ###
# Clé secrète pour signer les tokens JWT (utilisée si private.pem n'est pas protégé par passphrase)
# Pour plus de sécurité, utiliser le contenu du fichier private.pem est recommandé.
# Si private.pem est protégé par passphrase, cette clé n'est pas utilisée pour la signature.
JWT_SECRET_KEY=votre_cle_secrete_tres_longue_et_aleatoire_pour_dev # Ou contenu de private.pem

# Chemin vers la clé publique pour vérifier les tokens
JWT_PUBLIC_KEY=%kernel.project_dir%/config/jwt/public.pem

# Passphrase pour la clé privée (seulement si votre private.pem est protégé)
# Si votre clé privée n'a pas de passphrase, supprimez cette ligne ou laissez-la vide.
JWT_PASSPHRASE=cc62bd11c62d94940b535ed44dc933f6f1146949d0a7c7a169a297cfe051289a

# Durée de vie des access tokens (en secondes)
JWT_TOKEN_TTL=3600 # 1 heure
###< lexik/jwt-authentication-bundle ###


DB_NAME=twitter_db
DB_USER=user 
DB_PASSWORD=password
DB_HOST=127.0.0.1
DB_PORT=5432

DATABASE_URL="postgresql://$DB_USER:$DB_PASSWORD@$DB_HOST:$DB_PORT/$DB_NAME?serverVersion=16&charset=utf8"

###> symfony/routing ###
DEFAULT_URI=http://localhost
###< symfony/routing ###
